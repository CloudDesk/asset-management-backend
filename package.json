{
  "name": "asset-management-backend",
  "version": "1.0.0",
  "description": "Production-grade Node.js API backend with Fastify, TypeScript, and Prisma",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc",
    "start": "node build/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "verify:amazon-inventory": "npx tsx scripts/verify-amazon-inventory-handoff.ts",
    "test": "tsx --test src/**/*.test.ts tests/**/*.test.ts",
    "verify:return-module": "npm run test && npx prisma validate && npm run build -- --pretty false",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "set-project": "gcloud config set project nivaana",
    "deploy:sit": "gcloud builds submit . --config cloudbuildsit.yaml --project nivaana",
    "secrets:amazon:update": "bash scripts/update-amazon-secrets.sh",
    "secrets:amazon:update:redeploy": "bash scripts/update-amazon-secrets.sh --redeploy",
    "in-build": "docker build -t nivaana .",
    "in-tag": "docker tag nivaana gcr.io/nivaana/nivaana",
    "in-push": "docker push gcr.io/nivaana/nivaana",
    "in-deploy": "bash scripts/deploy-cloud-run-dev.sh",
    "in-deploy-2": "echo \"in-deploy-2 was removed because it contained plaintext secrets; use npm run in-deploy or Cloud Build instead.\" && exit 1",
    "full-deploy": "npm run set-project && npm run in-build && npm run in-tag && npm run in-push && npm run in-deploy",
    "sold:update": "npx tsx scripts/external-sold-update.ts",
    "taxonomy:dry-run": "npx tsx scripts/migrate-product-taxonomy.ts",
    "taxonomy:apply": "npx tsx scripts/migrate-product-taxonomy.ts --apply --confirm=NIVAANA_TWO_LEVEL_TAXONOMY",
    "taxonomy:dry-run:lower": "npx tsx scripts/migrate-product-taxonomy.ts --profile=lower",
    "taxonomy:apply:lower": "npx tsx scripts/migrate-product-taxonomy.ts --profile=lower --apply --confirm=NIVAANA_TWO_LEVEL_TAXONOMY",
    "taxonomy:gst:dry-run": "npx tsx scripts/migrate-gst-taxonomy.ts",
    "taxonomy:gst:apply": "npx tsx scripts/migrate-gst-taxonomy.ts --apply --confirm=NIVAANA_GST_TAXONOMY",
    "taxonomy:names:dry-run": "npx tsx scripts/migrate-product-names.ts",
    "taxonomy:names:apply": "npx tsx scripts/migrate-product-names.ts --apply --confirm=NIVAANA_PRODUCT_NAMES",
    "shortnames:dry-run": "npx tsx scripts/migrate-product-shortnames.ts",
    "shortnames:apply:dev": "npx tsx scripts/migrate-product-shortnames.ts --apply --confirm=NIVAANA_PRODUCT_SHORTNAMES_DEV"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PravinRaja22/asset-management-backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PravinRaja22/asset-management-backend/issues"
  },
  "homepage": "https://github.com/PravinRaja22/asset-management-backend#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.529.1",
    "@aws-sdk/s3-request-presigner": "^3.533.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/env": "^5.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/postgres": "^5.2.2",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@google-cloud/recaptcha-enterprise": "^6.3.0",
    "@google-cloud/storage": "^7.21.0",
    "@google-cloud/tasks": "^5.5.2",
    "@prisma/client": "^6.9.0",
    "@types/bcryptjs": "^2.4.6",
    "ajv": "^8.12.0",
    "ajv-errors": "^3.0.0",
    "autocannon": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "csv-stringify": "^6.5.1",
    "csvtojson": "^2.0.10",
    "docxtemplater": "^3.50.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "fastify-cookie": "^5.6.1",
    "fastify-multer": "^2.0.3",
    "fastify-plugin": "^4.5.1",
    "firebase-admin": "^12.7.0",
    "fs": "^0.0.1-security",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "latest": "^0.2.0",
    "lodash": "^4.17.21",
    "minimist": ">=0.2.4",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.14",
    "path": "^0.12.7",
    "perf_hooks": "^0.0.1",
    "pg": "^8.11.3",
    "pg-protocol": "^1.6.1",
    "pg-sdk-node": "^2.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pizzip": "^3.1.7",
    "qs": "^6.14.0",
    "redis": "^4.7.0",
    "revo-365_backend": "file:",
    "sanitize-html": "^2.17.6",
    "tsx": "^4.19.1",
    "twilio": "^5.10.2",
    "url": "^0.11.3",
    "uuid": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/ajv": "^0.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "assert": "^2.1.0",
    "axios": "^1.10.0",
    "eslint": "^8.56.0",
    "mocha": "^11.7.1",
    "prisma": "^6.15.0",
    "typescript": "^5.6.3"
  }
}

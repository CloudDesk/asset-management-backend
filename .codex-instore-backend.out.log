prisma:query 
      SELECT id, firstname, lastname, useremail, usermobilenumber, isguest
      FROM users
      WHERE isactive IS DISTINCT FROM FALSE
        AND (
          $1
          OR CONCAT_WS(' ', firstname, lastname) ILIKE $2
          OR COALESCE(useremail, '') ILIKE $3
          OR COALESCE(usermobilenumber::text, '') ILIKE $4
          OR id::text = $5
        )
      ORDER BY createddate DESC NULLS LAST, id DESC
      LIMIT $6
    

# GCP Cloud Run Environment Variables - Production Template
# Copy this file to env.prod.yaml and fill in your production credentials
# DO NOT commit env.prod.yaml with real credentials to Git!

# Database
DATABASE_URL: postgresql://username:password@host:port/database

# Server
NODE_ENV: production
PORT: "3000"

# Email Configuration
GMAIL_SERVICE: gmail
GMAIL_HOST: smtp.gmail.com
GMAIL_PORT: "465"
GMAIL_AUTH_USER: your-email@gmail.com
GMAIL_AUTH_PASSWORD: your-app-password

# URL Configuration
REDIRECT_URL_PAYMENT_STATUS: https://your-production-url.app
REDIRECT_URL_SUCCESS: com.YourApp.app://profile/orders
REDIRECT_URL_FAILURE: https://your-production-url.app/docs
API_BASE_URL: https://your-production-url.app

# GCP Configuration
GCP_PROJECT_ID: your-project-id
GCP_PROJECT_QUEUE: your-queue-name
GCP_PROJECT_LOCATION: asia-south1

# Firebase
FIREBASE_PROJECT_ID: your-firebase-project-id
FIREBASE_CLIENT_EMAIL: firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY: "-----BEGIN PRIVATE KEY-----\nYour-Key-Here\n-----END PRIVATE KEY-----\n"

# JWT Secret (IMPORTANT: Use a strong random secret!)
APP_JWT_SECRET: generate-strong-random-secret-minimum-32-characters

# PhonePe Configuration
PHONEPE_AUTH_MODE: production
PHONEPE_CLIENT_ID: your-production-client-id
PHONEPE_CLIENT_SECRET: your-production-client-secret
PHONEPE_CLIENT_VERSION: "1"
PHONEPE_OAUTH_URL: https://api.phonepe.com/apis/pg/v1/oauth/token/

# Twilio Configuration (REQUIRED for OTP)
TWILIO_ACCOUNT_SID: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN: your-twilio-auth-token
TWILIO_PHONE_NUMBER: "+1234567890"

# Redis Configuration (REQUIRED for OTP)
REDIS_HOST: your-redis-host.com
REDIS_PORT: "6379"
REDIS_PASSWORD: your-redis-password
REDIS_USERNAME: default

# OTP Configuration (Optional - has defaults)
OTP_EXPIRY_SECONDS: "60"
OTP_MAX_ATTEMPTS: "3"
RATE_LIMIT_SEND_MAX: "3"
RATE_LIMIT_SEND_WINDOW: "900"
RATE_LIMIT_VERIFY_MAX: "5"
RATE_LIMIT_VERIFY_WINDOW: "3600"
BLOCK_DURATION: "3600"


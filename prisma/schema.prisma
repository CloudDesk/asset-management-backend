  tickettype                String                   @db.VarChar(255)
  ticketpriority            String?                  @db.VarChar(500)
  transactionid             String?                  @db.VarChar(255)
  amount                    Decimal?                 @db.Decimal
  paymentmethod             String?                  @db.VarChar(255)
  transactiondate           BigInt?
  payeremail                String?                  @db.VarChar(255)
  issuedescription          String?
  recipturl                 String?                  @db.VarChar(200)
  trackingnumber            String?                  @db.VarChar(255)
  productname               String?                  @db.VarChar(255)
  purchasedate              BigInt?
  userid                    Int?
  location                  String?                  @db.VarChar(255)
  issuetype                 String?                  @db.VarChar(255)
  servicetype               String?                  @db.VarChar(255)
  proceedwithvalueservice   Boolean?                 @default(false)
  productcategory           String?                  @db.VarChar(255)
  productbrand              String?                  @db.VarChar(255)
  productmodel              String?                  @db.VarChar(255)
  receiversemail            String?                  @db.VarChar(250)
  assignedid                Int?
  approvedcostestimationid  Int?
  addressid                 Int?
  queuenumber               Int?
  closeddate                BigInt?
  reopenedticketdescription String?

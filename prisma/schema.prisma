  syncLog ChannelSyncLog?     @relation(fields: [syncLogId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt], map: "marketplace_listing_audits_listing_idx")
  @@index([syncLogId], map: "marketplace_listing_audits_sync_log_idx")

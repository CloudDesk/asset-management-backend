  easyShipHandoverMethod   String?   @db.VarChar(20)
  easyShipStatus           String?   @db.VarChar(50)
  amazonConfirmationStatus String    @default("NOT_REQUIRED") @db.VarChar(30)
  amazonConfirmedAt        DateTime? @db.Timestamptz(3)
  lastError                String?   @db.Text
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  order      AmazonMarketplaceOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  audits     AmazonOrderFulfillmentAudit[]
  exceptions AmazonOrderFulfillmentException[]

  @@index([route, workflowStatus], map: "amazon_order_fulfillment_route_status_idx")
  @@map("amazon_order_fulfillments")
}

model AmazonOrderFulfillmentAudit {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  orderId       BigInt   @db.BigInt
  fulfillmentId BigInt?  @db.BigInt
  action        String   @db.VarChar(50)
  fromStatus    String?  @db.VarChar(40)
  toStatus      String?  @db.VarChar(40)
  outcome       String   @db.VarChar(20)
  details       Json?
  actorUserId   Int?
  actorUserType String?  @db.VarChar(30)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  order       AmazonMarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment AmazonOrderFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt], map: "amazon_order_fulfillment_audit_order_created_idx")
  @@map("amazon_order_fulfillment_audits")
}

model AmazonOrderFulfillmentException {
  id                 BigInt    @id @default(autoincrement()) @db.BigInt
  orderId            BigInt    @db.BigInt
  fulfillmentId      BigInt?   @db.BigInt
  action             String    @db.VarChar(50)
  status             String    @default("OPEN") @db.VarChar(20)
  errorCode          String    @db.VarChar(100)
  message            String    @db.Text
  retryPayload       Json?
  retryCount         Int       @default(0)
  lastRetriedAt      DateTime? @db.Timestamptz(3)
  resolutionNote     String?   @db.Text
  resolvedByUserId   Int?
  resolvedByUserType String?   @db.VarChar(30)
  resolvedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  order       AmazonMarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment AmazonOrderFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt], map: "amazon_order_fulfillment_exception_status_idx")
  @@index([orderId, status], map: "amazon_order_fulfillment_exception_order_idx")
  @@map("amazon_order_fulfillment_exceptions")
}


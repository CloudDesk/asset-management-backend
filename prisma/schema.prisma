  marketplace         String   @default("AMAZON") @db.VarChar(30)
  environment         String   @default("PRODUCTION") @db.VarChar(20)
  marketplaceId       String   @db.VarChar(50)
  sellerId            String   @db.VarChar(255)
  sellerSku           String   @db.VarChar(255)
  operation           String   @db.VarChar(50)
  changedFields       Json
  beforeValues        Json?
  afterValues         Json?

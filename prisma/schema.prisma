generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                   BigInt      @id @default(autoincrement())
  name                 String      @db.VarChar(500)
  shortdescription     String?
  fulldescription      String?
  puc                  String      @unique @db.VarChar(255)
  category             String?     @db.VarChar(255)
  subcategory          String?     @db.VarChar(255)
  subsubcategory       String?     @db.VarChar(255)
  fragnancetype        String?     @db.VarChar(255)
  large                String[]
  medium               String[]
  small                String[]
  brand                String?     @db.VarChar(255)
  pack                 String?     @db.VarChar(255)
  searchtext           Unsupported("tsvector")?
  isdealoftheday        Boolean     @default(false)

  averagerating        Decimal?    @db.Decimal(2, 1)
  discount             Int?
  price                Decimal?    @db.Decimal(10, 2)
  createddate          BigInt?
  modifieddate         BigInt?

  quantity             Int?
  orderedquantity      Int?
  soldquantity         Int?
  availablequantity    Int?
  ecompublishedquantity Int?
  productstatus        String?     @db.VarChar(255)

  // Additional Product Information
  material             String?     @db.VarChar(255)
  itemlength           String?     @db.VarChar(255)
  manufacturer         String?     @db.VarChar(255)
  netform              String?     @db.VarChar(255)
  netquantity          String?     @db.VarChar(255)
  numberofitems        Int?
  itemthickness        String?     @db.VarChar(255)

  purpose              String?     @db.VarChar(255)
  burntime             String?     @db.VarChar(255)
  power                String?     @db.VarChar(255)
  usage                String?     @db.VarChar(255)
  longevity            String?     @db.VarChar(255)
  gender               String?     @db.VarChar(50)

  

  platformStocks       PlatformStock[]
  orderline             orderline[]
  stock                 Stock[]
  rating                rating[]

  @@map("product")
}

model PlatformStock {
  id            BigInt   @id @default(autoincrement())
  platform      String   @db.VarChar(100) // e.g. amazon, flipkart, nivapp
  availableqty  Int      @default(0)
  orderedqty    Int      @default(0)
  soldqty       Int      @default(0)
  totalqty      Int      @default(0)
  lockqty       Int?     @default(0) // Add this for NIVAPP cart locking
  createddate   BigInt?
  modifieddate  BigInt?
  productid     BigInt
  platformstatus        String?     @db.VarChar(255)
  // Relations
  product       Product  @relation(fields: [productid], references: [id], onDelete: Cascade)

  @@unique([productid, platform])
  @@map("platformstock")
}



model Stock {
  id                   BigInt      @id @default(autoincrement())
  puc                  String
  platform             String      @db.VarChar(100) // amazon, flipkart, nivapp
  manufacturedyear     BigInt?
  releaseyear          BigInt?
  isdeleted            Boolean?    @default(false)
  isarchive            Boolean?    @default(false)
  removefromrecyclebin Boolean?    @default(false)
  ecompublish          Boolean?    @default(false)
  solddate             BigInt?
  orderlinenumber      String?     @db.VarChar(500)
  searchtext           Unsupported("tsvector")?
  stockstatus          String      @default("available") @db.VarChar(500) // Available, Sold
  serialnumber         String?     @db.VarChar(500)
  sku                  String      @unique @db.VarChar(255)
  createddate          BigInt?
  modifieddate         BigInt?
  poid                 Int?
  supplierid           Int?
  batchno              String?     @db.VarChar(255)
  orderid              String?     @db.VarChar(500)
  platformhistory      Json?
  rfid                 String?     @db.VarChar(500)
  rfidscannedtime      BigInt?  

  // Relations
  product              Product?    @relation(fields: [puc], references: [puc], onDelete: Cascade, onUpdate: NoAction, map: "fk_puc")
  orderline            orderline?  @relation(fields: [orderlinenumber], references: [orderlinenumber], onDelete: NoAction, onUpdate: NoAction, map: "fk_orderlinenumber")
  orders               orders?     @relation(fields: [orderid], references: [orderid], onDelete: NoAction, onUpdate: NoAction, map: "stock_orderid_fkey")
  po                   PurchaseOrder? @relation(fields: [poid], references: [id])
  supplier             Supplier?      @relation(fields: [supplierid], references: [id])
  
  @@index([sku], map: "idx_stock_sku")
 @@index([platform], map: "idx_stock_platform")
  @@index([createddate], map: "idx_stock_createddate")
  @@index([id], map: "idx_stock_id")
  @@index([puc], map: "idx_stock_puc")
  @@index([stockstatus], map: "idx_stock_stockstatus")

  @@map("stock")
}



model Picklist {
  id                  Int     @id @default(autoincrement())
  label               String? @db.VarChar(255)
  value               String? @db.VarChar(255)
  object              String? @db.VarChar(255)
  controlledvalue     String? @db.VarChar(255)
  fieldname           String? @db.VarChar(255)
  controlledlabel     String? @db.VarChar(255)
  controlledfieldname String? @db.VarChar(255)
  parent              String? @db.VarChar(255)
  description         String? @db.VarChar(255)
  sortorder           Int?
  isactive            Boolean? @default(true)
  createddate          BigInt?
  modifieddate         BigInt?

  @@map("picklist")
}

model PicklistBackup {
  backup_id           Int      @id @default(autoincrement())
  id                  Int?
  label               String?  @db.VarChar(255)
  value               String?  @db.VarChar(255)
  object              String?  @db.VarChar(255)
  controlledvalue     String?  @db.VarChar(255)
  fieldname           String?  @db.VarChar(255)
  controlledlabel     String?  @db.VarChar(255)
  controlledfieldname String?  @db.VarChar(255)
  parent              String?  @db.VarChar(255)
  description         String?  @db.VarChar(255)
  sortorder           Int?
  isactive            Boolean?
  createddate         BigInt?
  modifieddate        BigInt?

  @@map("picklist_backup")
}


model Supplier {
  id                  Int               @id @default(autoincrement())
  suppliername        String?           @db.VarChar(300)
  supplierphonenumber BigInt?
  supplierlandline    BigInt?
  doornumber          String?           @db.VarChar(100)
  streetname          String?
  city                String?           @db.VarChar(100)
  state               String?           @db.VarChar(100)
  pincode             Decimal?          @db.Decimal
  isdeleted           Boolean?
  modifieddate        BigInt?
  createddate         BigInt?
  gstnumber           String?           @db.VarChar(500)
  supplieremail       String?           @db.VarChar(500)
  suppliercode        String?           @unique(map: "unique_supplier_code") @db.VarChar(50)
  suppliertype        String            @default("local") @db.VarChar(255)
  country             String?           @db.VarChar(255)
  stocks              Stock[]
  purchaseorder       PurchaseOrder[]
  purchaserequest     PurchaseRequest[]

  @@map("supplier")
}

model PurchaseOrder {
  id                  Int              @id @default(autoincrement())
  ponumber            String           @unique @db.VarChar(500)
  companyname         String?          @db.VarChar(500)
  companyaddress      String?          @db.VarChar(500)
  contactname         String?          @db.VarChar(500)
  phonenumber         Decimal?         @db.Decimal
  gstnumber           String?          @db.VarChar(500)
  io_companyname      String?          @db.VarChar(500)
  io_companyaddress   String?          @db.VarChar(500)
  io_contactname      String?          @db.VarChar(500)
  io_phonenumber      Decimal?         @db.Decimal
  io_gstnumber        String?          @db.VarChar(500)
  dt_companyname      String?          @db.VarChar(500)
  dt_companyaddress   String?          @db.VarChar(500)
  dt_contactname      String?          @db.VarChar(500)
  dt_phonenumber      Decimal?         @db.Decimal
  dt_gstnumber        String?          @db.VarChar(500)
  supplierid          Int?
  subtotal            Decimal?         @db.Decimal
  discount            Decimal?         @db.Decimal
  sgst                Decimal?         @db.Decimal
  cgst                Decimal?         @db.Decimal
  payabletaxamount    Decimal?         @db.Decimal
  total               Decimal?         @db.Decimal
  createddate         BigInt?
  modifieddate        BigInt?
  product             Json?
  po_status           String?          @db.VarChar(500)
  supplieraddress     String?          @db.VarChar(500)
  suppliercompanyname String?          @db.VarChar(500)
  supplierphonenumber Decimal?         @db.Decimal
  suppliergstnumber   String?          @db.VarChar(500)
  instructions        String?
  fileurl             String?          @db.VarChar(500)
  invoiceurl          String[]         @db.VarChar(500)
  sameasinvoice       Boolean?
  prnumber            String?          @db.VarChar(500)
  paymentterms        String?          @db.VarChar(500)
  overduedate         BigInt?
  comments            String?
  suppliertype        String           @default("local") @db.VarChar(255)
  poinvoice           poinvoice[]
  purchaserequest     PurchaseRequest? @relation(fields: [prnumber], references: [prnumber], onDelete: Cascade, onUpdate: NoAction, map: "fk_prnumber_purchaseorder")
  supplier            Supplier?        @relation(fields: [supplierid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_supplierid_purchaseorder_supplier")
  stocks    Stock[]
  @@map("purchaseorder")
}

model PurchaseRequest {
  id             Int             @default(autoincrement())
  createddate    BigInt?
  modifieddate   BigInt?
  prstatus       String?         @default("In Progress") @db.VarChar(500)
  companyname    String?         @db.VarChar(500)
  companyaddress String?         @db.VarChar(500)
  contactname    String?         @db.VarChar(500)
  phonenumber    BigInt?
  gstnumber      String?         @db.VarChar(500)
  companymail    String?         @db.VarChar(500)
  supplierid     Int?
  prurl          String?         @db.VarChar(500)
  prdata         Json?
  prnumber       String          @id @db.VarChar(500)
  supplieremail  String?         @db.VarChar(200)
  purchaseorder  PurchaseOrder[]
  supplier       Supplier?       @relation(fields: [supplierid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_supplierid_purchaserequest")
  quotes         quotes[]

  @@map("purchaserequest")
}

model address {
  id           Int         @id(map: "pk_address") @default(autoincrement())
  userid       Int?
  name         String?     @db.VarChar(100)
  mobilenumber Decimal?    @db.Decimal
  pincode      Decimal?    @db.Decimal
  doornumber   String?     @db.VarChar(100)
  address      String?
  landmark     String?     @db.VarChar(100)
  state        String?     @db.VarChar(100)
  city         String?     @db.VarChar(100)
  modifieddate BigInt?
  createddate  BigInt?
  users        users?      @relation(fields: [userid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_userid_address_user")
  orderline    orderline[]
  orders       orders[]
}

model cart {
  id           Int      @id @default(autoincrement())
  productid    BigInt?
  userid       Int?
  createddate  BigInt?
  quantity     Decimal? @db.Decimal
  iscart       Boolean? @default(false)
  iswishlist   Boolean? @default(false)
  modifieddate BigInt?
}

model exchange_rates {
  currency      String    @id @db.VarChar(5)
  exchange_rate Decimal?  @db.Decimal(10, 4)
  last_updated  DateTime? @db.Timestamp(6)
}

model inventoryusers {
  id                Int     @id @default(autoincrement())
  useremail         String? @unique(map: "unique_email_inventory_users") @db.VarChar(255)
  userpassword      String? @db.VarChar(255)
  createddate       BigInt?
  modifieddate      BigInt?
  role              String? @db.VarChar(500)
  usersphonenumber  BigInt?
  firstname         String? @db.VarChar(255)
  lastname          String? @db.VarChar(255)
  location          String? @db.VarChar(500)
  fcmid             String? @db.VarChar(400)
  sessiontoken      String? @db.VarChar(255)
  resettoken        String? @db.VarChar(255)
  resettokenexpires BigInt?
  
  // ADD THIS: One inventory user has one role (one-to-many relationship)
  roleid           Int?        // Foreign key to roles.id
  rolerelation     role?       @relation(fields: [roleid], references: [id], onDelete: SetNull)
  
  // Note: amazonConnections relation removed - using userType field instead
  
  @@index([roleid])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model locationhistory {
  id              Int     @default(autoincrement())
  location        String? @db.VarChar(500)
  lastlocation    String? @db.VarChar(500)
  scannedlocation String? @db.VarChar(500)
  modifieddate    BigInt?
  createddate     BigInt?
  stockid         Int?
  scannedtime     BigInt?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model logistics_costs {
  region             String?
  logistics_cost_qar Float?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model notes {
  id           Int      @default(autoincrement())
  createddate  BigInt?
  modifieddate BigInt?
  quotenumber  String?  @db.VarChar(500)
  comment      String?
  title        String?  @db.VarChar(500)
  ispinned     Boolean? @default(false)
  quotes       quotes?  @relation(fields: [quotenumber], references: [quotenumber], onDelete: Cascade, onUpdate: NoAction, map: "fk_quotenumber_notes")

  @@ignore
}

model orderline {
  id              Int       @id @default(autoincrement())
  orderid         Int  
  orderlinenumber String?   @unique(map: "unique_orderlinenumber") @db.VarChar(500)
  productid       BigInt?
  quantity        Int?
  createddate     BigInt?
  modifieddate    BigInt?
  userid          Int?
  addressid       Int?
  productamount   Decimal?  @db.Decimal(10,2)
  discountamount  Decimal?  @db.Decimal(10,2)
  orderamount     Decimal?  @db.Decimal(10,2)
  merchanttransactionid String? @db.VarChar(500)
  productname     String?   @db.VarChar(500)
  productcategory String?   @db.VarChar(500)
  productcolour   String?   @db.VarChar(500)
  readytodispatchdate BigInt?
  delivereddate   BigInt?
  cancelleddate   BigInt?
  returneddate    BigInt?
  orderstatus     String?   @db.VarChar(500)
  uniqueordderid  String?   @db.VarChar(500)
  deliveryfrom    String?   @db.VarChar(500)
  location        String?   @db.VarChar(500)
  dispatcheddate  BigInt?
  ordereddate     BigInt?
  paymentfaileddate BigInt?
  evaluation_id   String?   @db.VarChar(36)
  original_price  Decimal?  @db.Decimal(10,2)
  product_discount_amount  Decimal? @db.Decimal(10,2) @default(0)
  promotion_discount_amount Decimal? @db.Decimal(10,2) @default(0)
  shipping_cost            Decimal? @db.Decimal(10,2) @default(0)
  // EKART Shipment Information (shared with order)
  tracking_id             String?   @db.VarChar(500)
  shipdate                BigInt?
  address         address?  @relation(fields: [addressid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product         Product?  @relation(fields: [productid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users?    @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating          rating[]
  stock           Stock[]
  tickets         tickets[] @ignore
  orders          orders?   @relation(fields: [orderid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("orderline")
}

model orders {
  id                    Int                      @id @default(autoincrement())
  userid                Int?
  addressid             Int?
  createddate           BigInt?
  modifieddate          BigInt?
  orderamount           Decimal?                 @db.Decimal
  orderid               String?                  @unique(map: "uniq_orderid") @db.VarChar(500)
  orderstatus           String?                  @db.VarChar(500)
  delivereddate         BigInt?
  cancelleddate         BigInt?
  returneddate          BigInt?
  quantity              Int?
  transactionid         String?                  @db.VarChar(500)
  readytodispatchdate   BigInt?
  dispatcheddate        BigInt?
  productamount         Decimal?                 @db.Decimal
  discountamount        Decimal?                 @db.Decimal
  deliveryfrom          String?                  @db.VarChar(200)
  orderprocessingtime   BigInt?
  ispaymentsucceed      Boolean?                 @default(false)
  merchanttransactionid String?                  @db.VarChar(250)
  productid             Int[]
  evaluation_id         String?                   @db.VarChar(36) @unique
  promotion_discount_total    Decimal?            @db.Decimal(10,2) @default(0) // order-level + item-level promo discounts
  original_total        Decimal?                  @db.Decimal(10,2)   // subtotal of items before any discount
  shipping_cost         Decimal?                  @db.Decimal(10,2) @default(0)
  tax_amount            Decimal?                  @db.Decimal(10,2) @default(0)
  paymentfaileddate     BigInt?
  searchtext            Unsupported("tsvector")?
  // Payment Mode & COD Tracking
  mode                        String?   @db.VarChar(50)  // 'cod' | 'phonepe'
  cod_payment_received_date   BigInt?                    // When COD payment collected (epoch milliseconds)
  cod_transaction_reference   String?   @db.VarChar(500) // EKART/payment gateway transaction reference
  cod_amount                  Decimal?  @db.Decimal(10,2) // COD amount for verification and reconciliation
  // EKART Shipment Information
  tracking_id           String?                   @db.VarChar(500)
  vendor                String?                   @db.VarChar(100) @default("EKART")
  barcodes              Json?
  label_url             String?                   @db.VarChar(1000)
  public_tracking_link  String?                   @db.VarChar(1000)
  shipment_created_at   BigInt?
  label_downloaded_at   BigInt?
  label_printed_at      BigInt?
  shipdate              BigInt?
  orderline             orderline[]
  address               address?                 @relation(fields: [addressid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_addressid_orders")
  transaction           transaction?             @relation(fields: [transactionid], references: [transactionid], onDelete: Cascade, onUpdate: NoAction, map: "fk_transactionid")
  users                 users?                   @relation(fields: [userid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_userid_orders")
  revoinvoice           revoinvoice[]
  stock                 Stock[]
}

model permissions {
  id             Int     @id @default(autoincrement())
  permissionname String  @db.VarChar(255)
  permissionset  Json
  role           String  @db.VarChar(255)
  createddate    BigInt?
  modifieddate   BigInt?
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model poinvoice {
  id                    Int            @id @default(autoincrement())
  invoiceamount         Decimal?       @db.Decimal
  ponumber              String?        @db.VarChar(500)
  invoicedate           BigInt?
  invoicenumber         String?        @db.VarChar(500)
  invoiceurl            String?        @db.VarChar(500)
  paymentdata           Json?
  createddate           BigInt?
  modifieddate          BigInt?
  balanceamount         Decimal?       @db.Decimal
  iscreditpayment       Boolean?       @default(false)
  paymentduedate        BigInt?
  invoicestatus         String?        @db.VarChar(100)
  pototal               Decimal?       @db.Decimal
  purchaseorderstatus   String?        @db.VarChar(500)
  transportationcharges Decimal?       @db.Decimal(15, 2)
  exchangeamount        Decimal?       @db.Decimal(15, 2)
  customdutytaxamount   Decimal?       @db.Decimal(15, 2)
  suppliertype          String?        @db.VarChar(255)
  customdutychallanurl  String?        @db.VarChar(255)
  billofentryurl        String?        @db.VarChar(255)
  purchaseorder         PurchaseOrder? @relation(fields: [ponumber], references: [ponumber], onDelete: Cascade, onUpdate: NoAction, map: "fk_ponumber_invoice")

  @@map("poinvoice")
}

model pricing_markup {
  id                BigInt   @id @default(autoincrement())
  category          String?  @db.VarChar(255)
  subcategory       String?  @db.VarChar(255)
  markup_percentage Decimal? @db.Decimal(5, 2)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model quotes {
  id              Int              @id @default(autoincrement())
  createddate     BigInt?
  modifieddate    BigInt?
  quotestatus     String?          @db.VarChar(500)
  quotedata       Json?
  prnumber        String?          @db.VarChar(500)
  quoteurl        String?          @db.VarChar(500)
  quotenumber     String?          @unique(map: "unique_quotenumber") @db.VarChar(500)
  notes           notes[]          @ignore
  purchaserequest PurchaseRequest? @relation(fields: [prnumber], references: [prnumber], onDelete: Cascade, onUpdate: NoAction)

  @@map("quotes")
}

model rating {
  id           Int        @id @default(autoincrement())
  userid       Int?
  productid    BigInt?
  orderid      Int?
  starrating   Int?
  comments     String?
  createddate  BigInt?
  modifieddate BigInt?
  url          String[]   @db.VarChar
  usermail     String?    @db.VarChar(500)
  orderlineid  Int?
  orderline    orderline? @relation(fields: [orderlineid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orderline_rating_id")
  users        users?     @relation(fields: [userid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product      Product?   @relation(fields: [productid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userid], map: "idx_rating_userid")
  @@index([productid], map: "idx_rating_productid")
  @@index([orderid], map: "idx_rating_orderid")
  @@index([starrating], map: "idx_rating_starrating")
  @@index([createddate], map: "idx_rating_createddate")
  @@map("rating")
}

model revoinvoice {
  id                  Int      @default(autoincrement())
  companyname         String?  @db.VarChar(500)
  companyaddress      String?  @db.VarChar(500)
  contactname         String?  @db.VarChar(500)
  phonenumber         Decimal? @db.Decimal
  gstnumber           String?  @db.VarChar(500)
  customername        String?  @db.VarChar(500)
  customeraddress     String?  @db.VarChar(500)
  customerphonenumber Decimal? @db.Decimal
  invoicedate         BigInt?
  invoicenumber       String   @id(map: "revo_invoice") @db.VarChar(500)
  invoiceurl          String?  @db.VarChar(100)
  invoicedata         Json?
  createddate         BigInt?
  modifieddate        BigInt?
  invoicefor          String?  @db.VarChar(100)
  orderid             String?  @db.VarChar(500)
  servicedata         Json?
  gst                 String?  @db.VarChar(255)
  taxamount           Decimal? @db.Decimal
  discount            Decimal? @db.Decimal
  totalorderamount    Decimal? @db.Decimal
  ticketnumber        String?  @db.VarChar
  iscreditpayment     Boolean? @default(false)
  paymentduedate      BigInt?
  servicetype         Decimal? @default(0) @db.Decimal
  customergstnumber   String?  @db.VarChar(20)
  tickets             tickets? @relation(fields: [ticketnumber], references: [ticketnumber], onDelete: NoAction, onUpdate: NoAction, map: "fk_ticketnumber") @ignore
  orders              orders?  @relation(fields: [orderid], references: [orderid], onDelete: NoAction, onUpdate: NoAction)
}

model servicecostestimation {
  id                 Int      @id @default(autoincrement())
  createddate        BigInt?
  modifieddate       BigInt?
  ticketnumber       String?  @db.VarChar(500)
  estimationurl      String?  @db.VarChar(500)
  estimationstatus   String?  @db.VarChar(500)
  productdata        Json?
  servicedata        Json?
  productcgst        Decimal? @db.Decimal
  productsgst        Decimal? @db.Decimal
  producttaxamount   Decimal? @db.Decimal
  producttotal       Decimal? @db.Decimal(10, 2)
  servicecgst        Decimal? @db.Decimal
  servicesgst        Decimal? @db.Decimal
  servicetds         Decimal? @db.Decimal
  servicetaxamount   Decimal? @db.Decimal
  servicetotal       Decimal? @db.Decimal
  totalpayableamount Decimal? @db.Decimal
  approvalcomments   String?
  servicetype        Decimal? @default(0) @db.Decimal
  tickets            tickets? @relation(fields: [ticketnumber], references: [ticketnumber], onDelete: NoAction, onUpdate: NoAction) @ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model test_orders {
  order_id        String?
  order_date      String?
  customer_id     String?
  region          String?
  product_id      String?

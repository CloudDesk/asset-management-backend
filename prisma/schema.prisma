  description String?  @db.VarChar(500)
  isactive    Boolean  @default(true)
  issystem    Boolean  @default(false)          // System roles cannot be deleted
  
  // Relations
  permissionsets permissionset[]
  inventoryusers inventoryusers[]  // One-to-many: one role can have many inventory users
  parentroleid   Int?
  parentrole     role?     @relation("RoleHierarchy", fields: [parentroleid], references: [id], onDelete: SetNull)
  childroles     role[]    @relation("RoleHierarchy")
  
  createddate    BigInt?
  modifieddate   BigInt?
  
  @@unique([level])
  @@index([code])
  @@index([level])
  @@map("roles")
}

// 2. Permission Sets - Collection of permissions for a role
// Permissions stored as JSONB (not separate table)
model permissionset {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  roleid      Int?     // NULL for system-wide default
  role        role?    @relation(fields: [roleid], references: [id], onDelete: Cascade)
  isactive    Boolean  @default(true)
  isdefault   Boolean  @default(false)          // System-wide default (not per-role) - used as fallback when role has no active set
  
  // Permissions stored as JSONB array
  // Structure: Array of permission objects
  permissions      Json         // See structure below
  
  createddate      BigInt?
  modifieddate     BigInt?
  
  @@index([roleid])
  @@index([isactive])
  @@map("permission_sets")
}

// 3. User Hierarchy (OPTIONAL - for manager-subordinate relationships)
model userhierarchy {
  id            Int      @id @default(autoincrement())
  userid        Int      @unique
  managerid     Int?     // User's manager ID
  subordinates  Json?    // Array of subordinate user IDs: [1, 2, 3]
  
  createddate   BigInt?
  modifieddate  BigInt?
  
  @@index([managerid])
  @@map("user_hierarchies")
}

model users {
  id               Int         @id @default(autoincrement())
  useremail        String?     @unique(map: "unique_email_users") @db.VarChar(255)
  userpassword     String?     @db.VarChar(255)
  createddate      BigInt?
  modifieddate     BigInt?
  usermobilenumber BigInt?
  fcmid            String?     @db.VarChar(500)
  firstname        String?     @db.VarChar(500)
  lastname         String?     @db.VarChar(500)
  gender           String?     @db.VarChar(50)
  gstnumber        String?     @db.VarChar(20)
  isbusinessuser   Boolean?    @default(false)
  isguest          Boolean?    @default(false)
  isactive         Boolean?    @default(true)
  
  // Existing relations
  address          address[]
  orderline        orderline[]
  orders           orders[]
  returnrequests   ReturnRequest[]
  returnrequestattachments ReturnRequestAttachment[]
  tickets          tickets[]   @ignore
  rating           rating[]
  promotion_assignments promotion_assignments[]
  customer_group_members customer_group_members[]
  // Note: amazonConnections relation removed - using userType field instead

  @@map("users")
}

model pushdevice {
  id               Int      @id @default(autoincrement())
  userid           Int?
  inventoryuserid  Int?
  usertype         String   @db.VarChar(30)
  token            String   @unique @db.VarChar(2048)
  platform         String   @db.VarChar(30)
  provider         String   @db.VarChar(30)
  deviceid         String?  @db.VarChar(255)
  appversion       String?  @db.VarChar(100)
  buildnumber      String?  @db.VarChar(100)
  permissionstatus String?  @db.VarChar(50)
  isactive         Boolean  @default(true)
  failurecount     Int      @default(0)
  createddate      BigInt?
  modifieddate     BigInt?
  lastseenat       BigInt?
  disabledat       BigInt?

  @@index([userid])
  @@index([inventoryuserid])
  @@index([usertype])
  @@index([platform])
  @@index([isactive])
  @@map("push_devices")
}

model StorefrontPageSection {
  id             BigInt   @id @default(autoincrement()) @db.BigInt
  page_key       String   @default("home") @db.VarChar(80)
  section_key    String   @db.VarChar(120)
  section_type   String   @db.VarChar(80)
  name           String   @db.VarChar(255)
  attributes     Json     @default("{}")
  sort_order     Int      @default(0)
  is_active      Boolean  @default(true)
  schedule_start DateTime? @db.Timestamptz(6)
  schedule_end   DateTime? @db.Timestamptz(6)
  version        Int      @default(1)
  createdby      Int?
  modifiedby     Int?
  createddate    BigInt?
  modifieddate   BigInt?

  @@index([page_key, section_key], map: "idx_storefront_page_sections_page_section")
  @@index([page_key, section_key, is_active, sort_order], map: "idx_storefront_page_sections_active_order")
  @@index([section_type], map: "idx_storefront_page_sections_type")
  @@map("storefront_page_sections")
}





model promotions {
  id              Int       @id @default(autoincrement())
  name            String?   @db.Text
  description     String?   @db.Text
  type            String?   @db.Text // PERCENT_OFF_ITEM, FIXED_AMOUNT_OFF_ITEM, BOGO, PERCENT_OFF_CART, FIXED_AMOUNT_OFF_CART, FREE_SHIPPING,FREE_PRODUCT
  code            String?   @db.Text // Coupon code (NULL for automatic promotions, populated for coupon-based promotions)
  auto_apply      Boolean?
  start_date      BigInt?   // Unix timestamp (seconds since epoch)
  end_date        BigInt?   // Unix timestamp (seconds since epoch)
  status          String?   @db.Text
  priority        Int?
  visibility      String?   @db.Text
  applicable_channel String @default("all") @db.VarChar(20) // all, web, mobile
  application_mode String @default("click_to_apply") @db.VarChar(30) // automatic, click_to_apply, code_entry
  max_redemptions Int?     // Total usage limit (replaces total_usage_limit from coupons)
  per_user_limit  Int?     // Usage limit per user (replaces usage_limit_per_user from coupons)
  stackable       Boolean?
  budget          Decimal?  @db.Decimal(10, 2)
  timezone        String?   @db.VarChar(50)
  evaluation_expiry_minutes Int? @default(15)
  conditions      Json?     // Array of condition objects: [{ "attribute": "cart.total_value", "operator": "GTE", "value": 500 }]
  action          Json?     // Single action object: { "type": "PERCENT_OFF", "value": 15, "max_discount": 500 }
  createddate     BigInt?
  modifieddate    BigInt?

  // Relations
  redemptions           promotion_redemptions[]
  assignments           promotion_assignments[]

  @@index([application_mode])
  @@map("promotions")
}

model promotion_evaluations {
  evaluation_id        String   @id @db.VarChar(36)
  user_id              String?  @db.Text
  cart_data            Json?
  cart_signature       String? @db.VarChar(255)
  original_total       Decimal? @db.Decimal(10, 2)
  discounted_total     Decimal? @db.Decimal(10, 2)
  applied_promotions   Json?
  ineligible_coupons   Json?
  context              Json? // channel, geo, payment_method
   order_id             Int?    @unique              // FK -> orders.id (nullable until redeemed)
  created_at           BigInt @db.BigInt 
  expires_at           BigInt @db.BigInt 
  status               String?  @default("active") @db.VarChar(50)
  createddate          BigInt?
  modifieddate         BigInt?
  
  redemptions promotion_redemptions[]
  
  @@index([user_id, created_at])
  @@index([expires_at])
   @@index([cart_signature])
  @@map("promotion_evaluations")
}

model promotion_redemptions {
  id              String   @id @db.VarChar(36)
  evaluation_id   String   @db.VarChar(36)
  order_id        String?  @db.Text
  user_id         String?  @db.Text
  promotion_id    Int?
  assignment_id   Int?
  voucher_code    String?  @db.VarChar(100)
  discount_amount Decimal? @db.Decimal(10, 2)
  redeemed_at     BigInt
  redemption_data Json?
  createddate     BigInt?
  modifieddate    BigInt?
  
  evaluation promotion_evaluations @relation(fields: [evaluation_id], references: [evaluation_id])
  promotion  promotions?            @relation(fields: [promotion_id], references: [id])
  assignment promotion_assignments? @relation(fields: [assignment_id], references: [id], onDelete: SetNull)
  
  @@index([evaluation_id])
  @@index([order_id])
  @@index([assignment_id])
  @@index([voucher_code])
  @@unique([evaluation_id, promotion_id])
  @@map("promotion_redemptions")
}

model promotion_assignments {
  id                Int       @id @default(autoincrement())
  promotion_id      Int
  assignment_type   String    @db.VarChar(30) // customer, customer_group
  customer_id       Int?
  customer_group_id Int?
  voucher_code      String    @unique @db.VarChar(100)
  usage_limit       Int?
  used_count        Int       @default(0)
  start_date        BigInt?
  end_date          BigInt?
  status            String    @default("active") @db.VarChar(30)
  createddate       BigInt?
  modifieddate      BigInt?

  promotion      promotions       @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  customer       users?           @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  customer_group customer_groups? @relation(fields: [customer_group_id], references: [id], onDelete: Cascade)
  redemptions    promotion_redemptions[]

  @@index([promotion_id])
  @@index([customer_id])
  @@index([customer_group_id])
  @@index([status])
  @@map("promotion_assignments")
}

model customer_groups {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  code         String    @unique @db.VarChar(100)
  description  String?   @db.Text
  status       String    @default("active") @db.VarChar(30)
  createddate  BigInt?
  modifieddate BigInt?

  members     customer_group_members[]
  assignments promotion_assignments[]

  @@index([status])
  @@map("customer_groups")
}

model customer_group_members {
  id                Int       @id @default(autoincrement())
  customer_group_id Int
  customer_id       Int
  status            String    @default("active") @db.VarChar(30)
  createddate       BigInt?
  modifieddate      BigInt?

  customer_group customer_groups @relation(fields: [customer_group_id], references: [id], onDelete: Cascade)
  customer       users           @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([customer_group_id, customer_id])
  @@index([customer_id])
  @@index([status])
  @@map("customer_group_members")
}

model AmazonConnection {
  id            Int      @id @default(autoincrement())
  userId        Int      // Can reference either inventoryusers.id or users.id
  userType      String   @default("inventoryusers") @db.VarChar(50) // "inventoryusers" or "users"
  sellerId      String   @db.VarChar(255)
  refreshToken  String   @db.Text // Encrypted refresh token
  marketplaceId String   @default("A21TJRUUN4KGV") @db.VarChar(50)
  createdAt     BigInt?
  updatedAt     BigInt?
  
  // Relations - Note: We'll use userId + userType to determine which table to reference
  // Prisma doesn't support conditional relations, so we'll handle this in application code
  
  @@unique([userId, sellerId, userType])
  @@index([userId, userType])
  @@index([sellerId])
  @@map("amazon_connections")
}

// ============================================
// AUTHENTICATION & SESSION MANAGEMENT
// ============================================

model AuthSession {
  id                Int      @id @default(autoincrement())
  userId            Int
  userType          String   @db.VarChar(20) // 'inventory' or 'ecommerce'
  refreshTokenHash  String   @db.Text
  expiresAt         BigInt   // Unix timestamp in milliseconds
  isRevoked         Boolean  @default(false)
  ipAddress         String?  @db.VarChar(45) // Supports IPv4 and IPv6
  userAgent         String?  @db.Text
  createddate       BigInt?  // Matches other tables naming convention
  modifieddate      BigInt?  // Matches other tables naming convention

  // Prisma doesn't support conditional relations based on userType
  // Relations will be handled in application code

  @@index([userId, userType])
  @@index([refreshTokenHash])
  @@index([userId, userType, isRevoked])
  @@index([expiresAt])
  @@index([ipAddress, createddate])
  @@map("auth_sessions")
}

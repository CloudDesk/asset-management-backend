# =============================================================================
# Amazon SP-API — backend environment variables (reference, not loaded by the app)
# =============================================================================
# Copy only the lines an environment needs into its env file / Cloud Build trigger.
# Everything not listed here has a safe default in src/config/env.ts — do not set it.
# Details: docs/Amazon/Amazon_Master.md (sections 3, 4, 5a, 6.1).
#
# One live Amazon account, four databases (Amazon_Master.md section 1a):
#   Local  → assetmanagement_dev (same DB as SIT) · SIT → assetmanagement_dev
#   UAT    → assetmanagement_uat (Prod-like copy) · Prod → railway (live)
# Writes to Amazon ONLY from Prod. Mappings stay in each database.
#
# Per environment (section 1 = the 4 connection values in every environment)
#   Local : LISTING_IMPORT_ENABLED=true · ORDER_AUTO_SYNC_ENABLED=false · ENVIRONMENT=SANDBOX
#           · PRODUCTION_WRITES_ENABLED=false · AUTO_SYNC_ENABLED=false        (reads on demand)
#   SIT   : as Local + SCHEDULER_SECRET (Cloud Scheduler, hourly; the only scheduled runner on the dev DB)
#   UAT   : as SIT (Prod-like data; no writes — same live Amazon listings as Prod), except ONE
#           controlled single-listing Manual write test before go-live (Amazon_Master.md 1a)
#   Prod  : SCHEDULER_SECRET + ENVIRONMENT=PRODUCTION + PRODUCTION_WRITES_ENABLED=true
#           (+ AUTO_SYNC_ENABLED=true when automatic stock sync is wanted)  — after checklist 5a


# -----------------------------------------------------------------------------
# 1. CONNECTION — required in every environment that talks to Amazon (secrets)
# -----------------------------------------------------------------------------
# Seller Central → Apps and Services → Develop Apps → Nivaana app → View LWA credentials.
# A wrong pair gives "invalid_client"; a wrong refresh token gives "invalid_grant".
# SIT / UAT / Prod: GCP secrets via scripts/update-amazon-secrets.mjs (never commit values).

AMAZON_CLIENT_ID="amzn1.application-oa2-client.xxxxxxxx"   # LWA client ID of the app
AMAZON_CLIENT_SECRET="amzn1.oa2-cs.v1.xxxxxxxx"             # LWA client secret (expires; rotate in Seller Central)
AMAZON_REFRESH_TOKEN="Atzr|xxxxxxxx"                        # Seller's authorization of the app (self-authorize in Develop Apps)
AMAZON_SELLER_ID="APCBEZW09ZM60"                            # Merchant token of the seller account (not secret)


# -----------------------------------------------------------------------------
# 2. SWITCHES — off by default; turn on per environment
# -----------------------------------------------------------------------------

# Read Amazon listings (Mappings → Refresh, listing schedule). Needed for anything useful.
AMAZON_LISTING_IMPORT_ENABLED="true"

# How scheduled order import runs — choose ONE:
#   a) Cloud Scheduler (SIT / UAT / Prod on Cloud Run): set the secret, keep node-cron off
AMAZON_SCHEDULER_SECRET="<openssl rand -hex 24, different per environment>"
AMAZON_ORDER_AUTO_SYNC_ENABLED="false"
#   b) In-process node-cron (only an always-on server). NEVER "true" on a developer laptop:
#      local .env points at the shared dev DB and would add a job every 15 minutes.
# AMAZON_ORDER_AUTO_SYNC_ENABLED="true"

# Writes to Amazon (stock quantity, price, shipment confirmation). Both locks must be open:
#   AMAZON_ENVIRONMENT=PRODUCTION  AND  AMAZON_PRODUCTION_WRITES_ENABLED=true
# Only where the database holds the real Nivaana stock (go-live checklist: Amazon_Master.md 5a).
AMAZON_ENVIRONMENT="SANDBOX"                     # "PRODUCTION" only in Prod; anything else blocks writes
AMAZON_PRODUCTION_WRITES_ENABLED="false"         # "true" only in Prod, after the checklist

# Automatic stock sync after Nivaana stock changes (needs the two write locks above too).
AMAZON_AUTO_SYNC_ENABLED="false"                 # name says "auto sync" but it is STOCK auto sync only


# -----------------------------------------------------------------------------
# 3. OPTIONAL GROUPS — set only when the feature is used
# -----------------------------------------------------------------------------

# 3a. "Authorize Seller Account" button (per-user OAuth). Not needed when the shared
#     account above is used. Redirect URI must match the Inventory host of THAT environment
#     and be registered on the app in Seller Central.
# AMAZON_SP_API_APP_ID="amzn1.sp.solution.xxxxxxxx"
# AMAZON_OAUTH_VERSION="beta"                     # only while the app is in draft
# AMAZON_REDIRECT_URI="https://<inventory-host>/amazon/callback"
# AMAZON_TOKEN_ENCRYPTION_KEY="<64 hex chars or 32-byte base64>"   # encrypts stored OAuth tokens
# AMAZON_SELLER_CENTRAL_URL="https://sellercentral.amazon.in"

# 3b. Real-time Amazon notifications (AWS SQS / EventBridge). Not set up yet (AMZ-PLAN-09).
# AMAZON_NOTIFICATION_INGEST_SECRET="<32+ chars>"
# AMAZON_NOTIFICATION_SQS_DESTINATION_ID=""
# AMAZON_NOTIFICATION_EVENTBRIDGE_DESTINATION_ID=""
# AMAZON_NOTIFICATION_DESTINATION_ID=""           # older single-destination name

# 3c. Creating / editing Amazon listings from Nivaana (publish drafts). Off until needed.
# AMAZON_LISTING_CREATION_ENABLED="false"
# AMAZON_FULL_CATALOG_CREATION_ENABLED="false"
# AMAZON_LISTING_EDIT_ENABLED="false"

# 3d. Other in-process schedules (node-cron; prefer Cloud Scheduler endpoints where they exist).
# AMAZON_LISTING_AUTO_SYNC_ENABLED="false"        # Cloud Scheduler: POST /api/channels/amazon/jobs/listing-sync
# AMAZON_RETRY_WORKER_ENABLED="false"             # Cloud Scheduler: POST /api/channels/amazon/jobs/retry-queue
# AMAZON_RETURN_AUTO_SYNC_ENABLED="false"         # no Cloud Scheduler endpoint yet (AMZ-PLAN-05)


# -----------------------------------------------------------------------------
# 4. DEFAULTS — leave unset (shown only so you know they exist)
# -----------------------------------------------------------------------------
# AMAZON_INTEGRATION_ENABLED="true"               # master switch for all Amazon routes
# AMAZON_MARKETPLACE_ID="A21TJRUUN4KGV"           # Amazon.in
# AMAZON_PRODUCTION_SP_API_BASE_URL="https://sellingpartnerapi-eu.amazon.com"   # India is in the EU region
# AMAZON_ORDER_SYNC_CRON="*/15 * * * *"
# AMAZON_LISTING_SYNC_CRON="0 */6 * * *"
# AMAZON_RETRY_WORKER_CRON="*/5 * * * *"
# AMAZON_RETURN_SYNC_CRON="30 2 * * *"
# AMAZON_LISTING_IMPORT_PAGE_SIZE="20"
# AMAZON_LISTING_IMPORT_MAX_RETRIES="3"
# AMAZON_OAUTH_STATE_TTL_SECONDS="600"


# -----------------------------------------------------------------------------
# 5. REMOVE from every env file (not needed — AMZ-PLAN-22)
# -----------------------------------------------------------------------------
# Never read by the code:
#   AMAZON_SP_API_BASE_URL, AMAZON_AWS_IAM_ROLE_ARN, AMAZON_REGION
# Amazon sandbox (no real data; developer panel removed from the page 2026-10-21;
# the sandbox client ID / secret are a different Amazon app):
#   AMAZON_SANDBOX_CLIENT_ID, AMAZON_SANDBOX_CLIENT_SECRET, AMAZON_SANDBOX_REFRESH_TOKEN,
#   AMAZON_SANDBOX_SP_API_BASE_URL, AMAZON_SANDBOX_CREDENTIAL_SOURCE
